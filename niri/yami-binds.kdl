// yami: keybindings and keyboard layouts, written by the shell (settings → keys). Rewritten on every change:
// add your own in niri/user.kdl (included later, its keys win).
binds {
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+Space repeat=false hotkey-overlay-title="App launcher" { spawn "yami-shell" "msg" "launcher"; }
    Mod+P repeat=false { spawn "yami-shell" "msg" "launcher"; }
    Mod+E hotkey-overlay-title="Files" { spawn "yami-files"; }
    Mod+V repeat=false hotkey-overlay-title="Clipboard" { spawn "yami-shell" "msg" "clipboard"; }
    Mod+S repeat=false hotkey-overlay-title="Shell settings" { spawn "yami-shell" "msg" "settings"; }
    Mod+W repeat=false hotkey-overlay-title="Wallpaper picker" { spawn "yami-shell" "msg" "walls"; }
    Mod+Escape repeat=false allow-when-locked=false hotkey-overlay-title="Lock screen" { spawn "yami-shell" "msg" "lock"; }
    Mod+Shift+E repeat=false hotkey-overlay-title="Power menu" { spawn "yami-shell" "msg" "power"; }
    Ctrl+Alt+Delete repeat=false { spawn "yami-shell" "msg" "power"; }
    Mod+B repeat=false hotkey-overlay-title="Toggle bar" { spawn "yami-shell" "msg" "bar"; }
    Mod+Shift+Space repeat=false hotkey-overlay-title="Mode: desk / tiling" { spawn "yami-shell" "msg" "stacking"; }
    Mod+N repeat=false hotkey-overlay-title="Minimize window" { spawn "yami-shell" "msg" "minimize"; }
    Mod+Shift+N repeat=false hotkey-overlay-title="Restore last minimized" { spawn "yami-shell" "msg" "restore"; }
    Mod+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+C repeat=false hotkey-overlay-title="Close window" { close-window; }
    Alt+F4 repeat=false { close-window; }
    Mod+F hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+Ctrl+F { toggle-windowed-fullscreen; }
    Mod+G hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+T { center-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Down { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+K { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+J { move-window-down-or-to-workspace-down; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+H repeat=false hotkey-overlay-title="Hide the screen from streams" { spawn "yami-shell" "msg" "curtain"; }
    Print repeat=false hotkey-overlay-title="Screenshot" { spawn "yami-shell" "msg" "screenshot"; }
    Mod+Shift+S repeat=false { spawn "yami-shell" "msg" "screenshot"; }
    Ctrl+Print repeat=false hotkey-overlay-title="Screenshot: monitor" { spawn "yami-shell" "msg" "screenshot" "screen"; }
    Alt+Print repeat=false hotkey-overlay-title="Screenshot: window" { spawn "yami-shell" "msg" "screenshot" "window"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    Mod+Alt+K allow-when-locked=true { spawn-sh "yami-shell msg media play-pause || playerctl play-pause"; }
    Mod+Alt+J allow-when-locked=true { spawn-sh "yami-shell msg media next || playerctl next"; }
    Mod+Alt+L allow-when-locked=true { spawn-sh "yami-shell msg media previous || playerctl previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Ctrl+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+Ctrl+Q { quit; }
}

input {
    keyboard {
        xkb {
            layout "us"
            options "grp:alt_shift_toggle"
        }
    }
    focus-follows-mouse max-scroll-amount="0%"
}
